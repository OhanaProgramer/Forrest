# Forrest dashboard + camera/Hailo detection as a systemd *user* service.
# Holds the camera while it runs: stop it before forrest view or any other camera tool.
# Install: pi/systemd/install-dash.sh   (needs linger so it starts at boot without a login)
[Unit]
Description=Forrest dashboard + camera (forrest dash --camera, tailnet only)
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=%h/Projects/02_builds/forrest
# Pin the Tailscale IP: without it, a boot before Tailscale is up would fall back to 127.0.0.1.
# Until tailscale0 has the address the bind fails and systemd retries every 5 s.
# print straight to the journal (Python buffers stdout when it is not a terminal)
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/Projects/02_builds/forrest/.venv/bin/forrest dash --host 100.123.84.14 --port 8090 --camera
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
